      "description": "httpRequestsAdaptiveGroups, 8 days retention. Origin latency and bot score are Pro+ only.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "app": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "pod": true,
              "prometheus": true,
              "account": true
            },
            "renameByName": {
              "Value": "requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "requests",
                "desc": true
              }
            ]
          }
        }
      ]
